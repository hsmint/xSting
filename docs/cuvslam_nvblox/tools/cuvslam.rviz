Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.3
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Frames:
        All Enabled: false
        camera_link:
          Value: true
        vslam_map:
          Value: true
      Value: true
    - Class: rviz_default_plugins/Path
      Name: SLAM path
      Enabled: true
      Color: 0; 200; 255
      Line Style: Lines
      Topic:
        Value: /visual_slam/tracking/slam_path
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/Path
      Name: VO path
      Enabled: false
      Color: 255; 170; 0
      Line Style: Lines
      Topic:
        Value: /visual_slam/tracking/vo_path
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Landmarks (map points)
      Enabled: true
      Size (m): 0.02
      Style: Points
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Decay Time: 600
      Topic:
        Value: /visual_slam/vis/landmarks_cloud
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Observations (current frame)
      Enabled: true
      Size (Pixels): 5
      Style: Points
      Color Transformer: FlatColor
      Color: 0; 255; 0
      Decay Time: 0
      Topic:
        Value: /visual_slam/vis/observations_cloud
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/Camera
      Name: IR camera + points (overlay)
      Enabled: true
      Image Rendering: background and overlay
      Overlay Alpha: 0.6
      Zoom Factor: 1
      Visibility:
        Grid: false
        TF: false
        SLAM path: true
        Landmarks (map points): true
        Observations (current frame): true
        Value: true
      Topic:
        Value: /camera/camera/infra1_preview/image_raw
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Value: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: vslam_map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 3.6
    Saved: ~
