Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.4
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Frames:
        All Enabled: false
        base_footprint:
          Value: true
        camera_link:
          Value: true
        odom:
          Value: true
      Value: true
    - Class: nvblox_rviz_plugin/NvbloxMesh
      Name: nvblox mesh (3D map)
      Enabled: true
      Topic:
        Value: /nvblox_node/mesh
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: ESDF slice (distance to obstacles)
      Enabled: true
      Style: Flat Squares
      Size (m): 0.05
      Color Transformer: Intensity
      Channel Name: intensity
      Use rainbow: true
      Autocompute Intensity Bounds: true
      Decay Time: 0
      Topic:
        Value: /nvblox_node/static_esdf_pointcloud
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Occupancy grid (2D)
      Enabled: false
      Alpha: 0.7
      Color Scheme: costmap
      Topic:
        Value: /nvblox_node/static_occupancy_grid
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Value: false
    - Class: rviz_default_plugins/Path
      Name: cuVSLAM path
      Enabled: true
      Color: 0; 200; 255
      Line Style: Lines
      Topic:
        Value: /visual_slam/tracking/slam_path
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: cuVSLAM landmarks
      Enabled: true
      Size (Pixels): 3
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 0; 255
      Decay Time: 600
      Topic:
        Value: /visual_slam/vis/landmarks_cloud
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/Camera
      Name: IR camera + map (overlay)
      Enabled: true
      Image Rendering: background and overlay
      Overlay Alpha: 0.5
      Zoom Factor: 1
      Visibility:
        Grid: false
        TF: false
        nvblox mesh (3D map): true
        ESDF slice (distance to obstacles): false
        Occupancy grid (2D): false
        cuVSLAM path: true
        cuVSLAM landmarks: true
        Value: true
      Topic:
        Value: /camera/camera/infra1_preview/image_raw
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Value: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4
      Focal Point:
        X: 1
        Y: 0
        Z: 0
      Pitch: 0.7
      Yaw: 3.4
    Saved: ~
