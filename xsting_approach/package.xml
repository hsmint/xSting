<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xsting_approach</name>
  <version>1.0.0</version>
  <description>xSting 2cm precision box approach RL controller and calibration package</description>
  <maintainer email="xsting@example.com">xSting Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>vision_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>xsting_interfaces</depend>
  <exec_depend>foxglove_bridge</exec_depend>

  <build_depend>eigen</build_depend>
  <build_depend>libyaml-cpp-dev</build_depend>
  <exec_depend>libyaml-cpp-dev</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
