<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xsting_mission</name>
  <version>0.1.0</version>
  <description>주사위 기억 로봇 임무: 노트북 판단기(llm_commander)와 로봇 명령 서버(robot_command_server)</description>
  <maintainer email="spalstlr321@naver.com">minsikim-42</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>unique_identifier_msgs</exec_depend>
  <exec_depend>xsting_interfaces</exec_depend>
  <!-- llm 모드: pip install openai (노트북만), 키는 OPENAI_API_KEY -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
