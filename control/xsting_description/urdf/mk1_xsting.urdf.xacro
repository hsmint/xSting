  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.00974998" rpy="0 0 0"/>
  </joint>
  <joint name="pillar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="turret_link"/>
    <origin xyz="0.0023 0.0023 0.427" rpy="0 0 0"/>
  </joint>
  <!-- M1 turntable servo XM430 (top plate) -> disc -->
  <joint name="joint1" type="revolute">
    <parent link="turret_link"/>
    <child link="disc_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="1.5" velocity="4.8"/>
  </joint>
  <!-- M2 arm yaw servo (under the disc) -->
  <joint name="joint2" type="revolute">
    <parent link="disc_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0.055 0 -0.046" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="1.5" velocity="4.8"/>
  </joint>
  <!-- joint3-5 limits were measured by hand (control/my_tool/arm_freedrive.py, 2026-10-31) and set 5 deg
       inside the stops, except the folded home side of joint4 (+88.7 deg) and joint5 (-105.5 deg), which is
       the stop itself. Keep that side at or beyond HOME_TICK in opencr_definitions.hpp. -->
  <!-- M3 shoulder pitch servo -->
  <joint name="joint3" type="revolute">
    <parent link="shoulder_link"/>
    <child link="arm_link"/>
    <origin xyz="0 0 -0.0387" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.9431" upper="2.0189" effort="1.5" velocity="4.8"/>
  </joint>
  <!-- M4 elbow pitch servo -->
  <joint name="joint4" type="revolute">
    <parent link="arm_link"/>
    <child link="elbow_link"/>
    <origin xyz="0.024 0.128 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0168" upper="1.5478" effort="1.5" velocity="4.8"/>
  </joint>
  <!-- M5 wrist pitch servo -->
  <joint name="joint5" type="revolute">
    <parent link="elbow_link"/>
    <child link="wrist_link"/>
    <origin xyz="0.124 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.8417" upper="2.1032" effort="1.5" velocity="4.8"/>
  </joint>
  <!-- M6 wrist roll servo -->
  <joint name="joint6" type="revolute">
    <parent link="wrist_link"/>
    <child link="gripper_link"/>
    <origin xyz="0.0677 0 0" rpy="1.5708 0 1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="1.5" velocity="4.8"/>
  </joint>
  <!-- M7 gripper servo (rack and pinion, finger travel in m) -->
  <joint name="joint7" type="prismatic">
    <parent link="gripper_link"/>
    <child link="finger_l"/>
    <origin xyz="0 -0.0538053 0.0362773" rpy="-1.5708 -1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.0222" upper="0.0095" effort="10.0" velocity="0.05"/>
  </joint>
  <joint name="finger_r_joint" type="prismatic">
    <parent link="gripper_link"/>
    <child link="finger_r"/>
    <origin xyz="0 0.0537836 0.0362773" rpy="1.5708 -1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.0222" upper="0.0095" effort="10.0" velocity="0.05"/>
    <mimic joint="joint7" multiplier="1" offset="0"/>
  </joint>
  <joint name="gripper_camera_joint" type="fixed">
    <parent link="gripper_link"/>
    <child link="gripper_camera_link"/>
    <origin xyz="-0.0457846 0.000104348 0.0658504" rpy="0 -1.0472 0"/>
  </joint>
  <joint name="gripper_camera_optical_joint" type="fixed">
    <parent link="gripper_camera_link"/>
    <child link="gripper_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>
  <joint name="front_camera_joint" type="fixed">
    <parent link="turret_link"/>
    <child link="front_camera_link"/>
    <origin xyz="0.147257 -0.002243 0.0249983" rpy="0 0.523599 0"/>
  </joint>
  <!-- RealSense D435 body: 75 g (RealSense D400 datasheet rev 023, Table 3-52), split out of turret_link; its
       mounting bracket stays in turret_link. front_camera_link = centre of the D435 body (90 x 25 x 25 mm). Lens centres from the STEP front
       cover, x out of the glass (glass at x +12.5 mm), y to the camera's left: RGB +32.4 mm, left IR +17.4 mm
       (RealSense driver depth origin, camera_link of realsense2_description), projector -11.6 mm,
       right IR -32.6 mm. depth_cam_link sits on the IR projector, RGB_cam_link on the RGB lens. -->
  <joint name="depth_cam_joint" type="fixed">
    <parent link="front_camera_link"/>
    <child link="depth_cam_link"/>
    <origin xyz="0.00785 -0.011557 0" rpy="0 0 0"/>
  </joint>
  <joint name="RGB_cam_joint" type="fixed">
    <parent link="front_camera_link"/>
    <child link="RGB_cam_link"/>
    <origin xyz="0.00785 0.032443 0" rpy="0 0 0"/>
  </joint>
  <!-- RealSense driver mount. Launch realsense2_camera with camera_name:=camera and publish_tf on: the driver
       publishes camera_link -> camera_infra1/2_frame and the optical frames, this joint places camera_link.
       camera_link = left IR depth origin (realsense2_description), 4.2 mm behind the glass: x 12.5 - 4.2 mm, y +17.4 mm.
       Origin from Kalibr through the CAD imu_link (not the CAD lens position x 0.0083, y 0.0174): mean of two
       recordings (motion6/7, 2026-10-29, IMU at ~180 Hz, provisional IMU noise) that agree within 0.25 deg,
       0.9 cm and 0.7 ms. Camera ~37 cm above the IMU, ~28 deg down; timeshift_cam_imu = +12.4 ms. -->
  <joint name="d435_joint" type="fixed">
    <parent link="front_camera_link"/>
    <child link="camera_link"/>
    <origin xyz="0.01846 0.01268 -0.02405" rpy="-0.01654 -0.03745 -0.00868"/>
  </joint>
  <!-- The two OpenCR 1.0 boards (105 x 75 mm) of the STEP, origin = PCB centre (MANIFOLD_SOLID_BREP_33156),
       axes = parent axes (both boards lie flat, edges along x / y, same heading).
       2nd deck: FL2 > OPENCR_NEW_ASM <1>:1, front centre (PCB centre x 64 mm), directly on the FL2 plate (top z 46.5 mm), PCB z 49.79~51.51 mm.
       4th deck: FL2 > OPENCR_NEW_ASM <1>:2, on the top plate (top z 448.8 mm), PCB z 458.82~460.54 mm.
       Each board: 60 g (ROBOTIS OpenCR 1.0 e-manual), split out of base_link / turret_link. -->
  <joint name="opencr_joint" type="fixed">
    <parent link="base_link"/>
    <child link="opencr_link"/>
    <origin xyz="0.064 0 0.05065" rpy="0 0 0"/>
  </joint>
  <joint name="opencr_top_joint" type="fixed">
    <parent link="turret_link"/>
    <child link="opencr_top_link"/>
    <origin xyz="-0.0342 0.1222 0.032679" rpy="0 0 0"/>
  </joint>
  <!-- IMU (MPU9250, 3x3x1 mm, MANIFOLD_SOLID_BREP_33179) at the PCB centre of the 2nd deck OpenCR: chip centre is
       1.325 mm above the PCB centre. Axes = base_link, as turtlebot3_description's imu_joint. -->
  <joint name="imu_joint" type="fixed">
    <parent link="opencr_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.001325" rpy="0 0 0"/>
  </joint>
  <!-- Components split out of base_link / turret_link with datasheet masses (frame-only children: their
       meshes stay in the parent). Origin = component bbox centre, axes = parent axes. -->
  <!-- LB-012 LiPo 11.1 V 1800 mAh, 1st deck front centre (STEP LIPO_LB-012_11.1V_1800mAh:1), 106 g (ROBOTIS) -->
  <joint name="battery_joint" type="fixed">
    <parent link="base_link"/>
    <child link="battery_link"/>
    <origin xyz="0.064 0 0.022" rpy="0 0 0"/>
  </joint>
  <!-- LB-012 LiPo 11.1 V 1800 mAh, top plate (STEP LIPO_LB-012_11.1V_1800mAh:2), 106 g (ROBOTIS) -->
  <joint name="battery_top_joint" type="fixed">
    <parent link="turret_link"/>
    <child link="battery_top_link"/>
    <origin xyz="0.0682 0.1197 0.0348326" rpy="0 0 0"/>
  </joint>
  <!-- Jetson Orin Nano Developer Kit, top plate (STEP P3766-P3768SKU4-P3767ENVELOPE:1), 175 g (NVIDIA SP-11324-001) -->
  <joint name="jetson_joint" type="fixed">
    <parent link="turret_link"/>
    <child link="jetson_link"/>
    <origin xyz="-0.0013 -0.125738 0.038483" rpy="0 0 0"/>
  </joint>
  <!-- Wheel velocity limit: XM430-W210 tops out at 77 rpm (8.06 rad/s) at 12 V.
       ros2_control clamps wheel commands to this, so it must not sit below the motor's top speed. -->
  <joint name="wheel_front_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_left"/>
    <origin xyz="0.1 0.1439 0.02325" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1.5" velocity="8.1"/>
  </joint>
  <joint name="wheel_front_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_right"/>
    <origin xyz="0.1 -0.1439 0.02325" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1.5" velocity="8.1"/>
  </joint>
  <joint name="wheel_rear_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_left"/>
    <origin xyz="-0.1 0.1439 0.02325" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1.5" velocity="8.1"/>
  </joint>
  <joint name="wheel_rear_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_right"/>
    <origin xyz="-0.1 -0.1439 0.02325" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1.5" velocity="8.1"/>
  </joint>


  <xacro:arg name="use_mock_hardware" default="true"/>
  <!-- Same as wheel_port below: "auto" pings opencr_id on every /dev/ttyACM*. The old by-id path
       is shared with the wheel OpenCR, so with both boards plugged in it may point at either. -->
  <xacro:arg name="arm_port" default="auto"/>

  <!-- One arm cycle (read_all, heartbeat, joint and gripper goals) is about 6 OpenCR transactions,
       roughly 12 ms on the Jetson, which does not fit the 5 ms loop the wheel IMU needs.
       is_async runs it in its own thread at rw_rate so it never stalls the 200 Hz loop. -->
  <ros2_control name="XStingSystem" type="system" is_async="true" rw_rate="50">
    <hardware>
      <xacro:if value="$(arg use_mock_hardware)">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:unless value="$(arg use_mock_hardware)">
        <plugin>xsting_manipulation_hardware/XStingManipulationSystemHardware</plugin>
        <param name="opencr_id">200</param>
        <param name="opencr_usb_port">$(arg arm_port)</param>
        <param name="opencr_baud_rate">1000000</param>
        <param name="dxl_joints_profile_acceleration">10</param>
        <param name="dxl_joints_profile_velocity">10</param>
        <param name="dxl_gripper_profile_acceleration">1</param>
        <param name="dxl_gripper_profile_velocity">10</param>
      </xacro:unless>
    </hardware>

    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint6">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint7">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>


  <!-- Defaults to mock: if any hardware fails to initialize, ros2_control stops entirely,
       so a real wheel block without the board would take the arm down too. -->
  <xacro:arg name="use_mock_base" default="true"/>
  <!-- "auto" finds the wheel board by pinging opencr_id on every /dev/ttyACM*, so any USB socket
       and any PC works. A fixed path such as /dev/serial/by-path/... skips the search. -->
  <xacro:arg name="wheel_port" default="auto"/>

  <ros2_control name="XStingBase" type="system">
    <hardware>
      <xacro:if value="$(arg use_mock_base)">
        <plugin>mock_components/GenericSystem</plugin>
        <!-- Integrates velocity commands into wheel positions; without it odom stays at 0 in mock. -->
        <param name="calculate_dynamics">true</param>
      </xacro:if>
      <xacro:unless value="$(arg use_mock_base)">
        <plugin>xsting_base_hardware/XStingBaseSystemHardware</plugin>
        <param name="opencr_id">201</param>
        <param name="opencr_usb_port">$(arg wheel_port)</param>
        <param name="opencr_baud_rate">1000000</param>
      </xacro:unless>
    </hardware>

    <!-- Order must match base::wheels::Wheel: LEFT_1, LEFT_2, RIGHT_1, RIGHT_2 (motor ID 1-4).
         ID 1/3 are assumed to be the front wheels; swap front/rear here if the robot shows otherwise. -->
    <joint name="wheel_front_left_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="wheel_rear_left_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="wheel_front_right_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="wheel_rear_right_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Interface names follow what imu_sensor_broadcaster expects.
         The mock leaves sensor states at NaN, so /imu is all NaN until the real board is used. -->
    <sensor name="imu">
      <state_interface name="orientation.x"/>
      <state_interface name="orientation.y"/>
      <state_interface name="orientation.z"/>
      <state_interface name="orientation.w"/>
      <state_interface name="angular_velocity.x"/>
      <state_interface name="angular_velocity.y"/>
      <state_interface name="angular_velocity.z"/>
      <state_interface name="linear_acceleration.x"/>
      <state_interface name="linear_acceleration.y"/>
      <state_interface name="linear_acceleration.z"/>
    </sensor>
    
  </ros2_control>
</robot>
