<?xml version="1.0"?>
<!-- xSting mk1 for ros2_control: the shared CAD model (xsting_v62.urdf) plus what running the robot needs.
     xsting_v62.urdf holds the geometry, masses, meshes and joint limits (URDF sign, measured joint3-5 ranges);
     a new CAD version replaces that file (keep its "Local edits" list). This file adds:
       - the RealSense driver frames on both D435 bodies,
       - the ros2_control blocks for the arm and the wheel/IMU OpenCRs. -->
<robot name="xsting" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find xsting_description)/urdf/xsting_v62.urdf"/>

  <!-- RealSense driver mounts. realsense2_camera with publish_tf on publishes <camera_name>_link ->
       *_infra1/2_frame, *_depth_frame and the optical frames; these joints place <camera_name>_link, the left IR
       depth origin (realsense2_description), 4.2 mm behind the glass: x 12.5 - 4.2 mm, y +17.4 mm from the body
       centre (front_camera_link / lower_camera_body_link, see the D435 body comment in xsting_v62.urdf). -->
  <link name="camera_link"/>
  <link name="lower_camera_link"/>

  <!-- Top front D435, camera_name:=camera (cuVSLAM, nvblox). From Kalibr through the CAD imu_link
       (docs/cuvslam_nvblox/tools/compute_d435_joint.py), 2026-11-02, top plate at 55.5 cm, IR at 1280x720:
       rotation = mean of motion8/9 (agree within 0.2 deg; ~1 deg off the pre-rebuild motion6/7, so the rebuild
       tilted the camera), translation = motion9 alone. The two translations differ by 5.3 cm (motion8 put the
       camera 4.6 cm lower); motion9 had twice the rotation, matches the pre-rebuild 37.0 cm + 10 cm pillar = 47 cm
       above the IMU, and is within 1 cm of the CAD-propagated height. Camera ~27.4 deg down,
       timeshift_cam_imu = +17.1 ms (mean of 18.7 / 15.5). Re-run Kalibr with gentler, rotation-heavy motion
       (the taller robot sways, residuals were 2.5x those of motion6/7) to settle translation and timeshift. -->
  <joint name="d435_joint" type="fixed">
    <parent link="front_camera_link"/>
    <child link="camera_link"/>
    <origin xyz="0.04204 0.02198 -0.00886" rpy="-0.00503 -0.04540 -0.01867"/>
  </joint>

  <!-- 3rd deck D435, camera_name:=lower_camera. CAD only, not calibrated. -->
  <joint name="lower_d435_joint" type="fixed">
    <parent link="lower_camera_body_link"/>
    <child link="lower_camera_link"/>
    <origin xyz="0.0083 0.0174 0" rpy="0 0 0"/>
  </joint>


  <xacro:arg name="use_mock_hardware" default="true"/>
  <!-- Same as wheel_port below: "auto" pings opencr_id on every /dev/ttyACM*. The old by-id path
       is shared with the wheel OpenCR, so with both boards plugged in it may point at either. -->
  <xacro:arg name="arm_port" default="auto"/>

  <!-- One arm cycle (read_all, heartbeat, joint and gripper goals) is about 6 OpenCR transactions,
       roughly 12 ms on the Jetson, which does not fit the 5 ms loop the wheel IMU needs.
       is_async runs it in its own thread at rw_rate so it never stalls the 200 Hz loop. -->
  <ros2_control name="XStingSystem" type="system" is_async="true" rw_rate="50">
    <hardware>
      <xacro:if value="$(arg use_mock_hardware)">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:unless value="$(arg use_mock_hardware)">
        <plugin>xsting_manipulation_hardware/XStingManipulationSystemHardware</plugin>
        <param name="opencr_id">200</param>
        <param name="opencr_usb_port">$(arg arm_port)</param>
        <param name="opencr_baud_rate">1000000</param>
        <param name="dxl_joints_profile_acceleration">10</param>
        <param name="dxl_joints_profile_velocity">10</param>
        <param name="dxl_gripper_profile_acceleration">1</param>
        <param name="dxl_gripper_profile_velocity">10</param>
      </xacro:unless>
    </hardware>

    <!-- direction -1: the motor turns opposite to the URDF axis. The hardware negates that joint's position,
         velocity and command, so /joint_states and commands use the URDF sign (xsting_v62.urdf limits and home,
         RL in simulation). Checked for joint3-5 against the folded home pose; joint1, joint2, joint6 still
         need a check on the robot (move each a little and compare with RViz). HOME_TICK stays in motor ticks. -->
    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3">
      <param name="direction">-1</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4">
      <param name="direction">-1</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint5">
      <param name="direction">-1</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint6">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint7">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>


  <!-- Defaults to mock: if any hardware fails to initialize, ros2_control stops entirely,
       so a real wheel block without the board would take the arm down too. -->
  <xacro:arg name="use_mock_base" default="true"/>
  <!-- "auto" finds the wheel board by pinging opencr_id on every /dev/ttyACM*, so any USB socket
       and any PC works. A fixed path such as /dev/serial/by-path/... skips the search. -->
  <xacro:arg name="wheel_port" default="auto"/>

  <ros2_control name="XStingBase" type="system">
    <hardware>
      <xacro:if value="$(arg use_mock_base)">
        <plugin>mock_components/GenericSystem</plugin>
        <!-- Integrates velocity commands into wheel positions; without it odom stays at 0 in mock. -->
        <param name="calculate_dynamics">true</param>
      </xacro:if>
      <xacro:unless value="$(arg use_mock_base)">
        <plugin>xsting_base_hardware/XStingBaseSystemHardware</plugin>
        <param name="opencr_id">201</param>
        <param name="opencr_usb_port">$(arg wheel_port)</param>
        <param name="opencr_baud_rate">1000000</param>
      </xacro:unless>
    </hardware>

    <!-- Order must match base::wheels::Wheel: LEFT_1, LEFT_2, RIGHT_1, RIGHT_2 (motor ID 1-4).
         ID 1/3 are assumed to be the front wheels; swap front/rear here if the robot shows otherwise. -->
    <joint name="wheel_front_left_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="wheel_rear_left_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="wheel_front_right_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="wheel_rear_right_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Interface names follow what imu_sensor_broadcaster expects.
         The mock leaves sensor states at NaN, so /imu is all NaN until the real board is used. -->
    <sensor name="imu">
      <state_interface name="orientation.x"/>
      <state_interface name="orientation.y"/>
      <state_interface name="orientation.z"/>
      <state_interface name="orientation.w"/>
      <state_interface name="angular_velocity.x"/>
      <state_interface name="angular_velocity.y"/>
      <state_interface name="angular_velocity.z"/>
      <state_interface name="linear_acceleration.x"/>
      <state_interface name="linear_acceleration.y"/>
      <state_interface name="linear_acceleration.z"/>
    </sensor>
    
  </ros2_control>
</robot>
