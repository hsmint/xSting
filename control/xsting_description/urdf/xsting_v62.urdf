<?xml version="1.0"?>
<!-- Generated from ~/Desktop/KANT/xSting/model/xSting_v62.step by scripts/build_urdf_linear.py + hand edits of xSting_roll_v44.urdf, then scripts/make_xsting_48.py (OpenCR / LiPo / FL1 brackets moved, LDS-03 removed) and scripts/make_xsting_51.py (wheelbase 200 mm, OpenCR / LiPo / FL1 brackets / 2nd-deck pillars moved, 150 mm turntable disc, arm moved on the disc) and scripts/make_xsting_final.py (lower D435 on the 3rd deck, top-plate bracket / Jetson clamps / LiPo changes, visuals coloured by part kind) and scripts/make_xsting_v62.py (top layer +100 mm, 82 mm forearm link, new baskets, measured joint3~5 limits). Masses: datasheet values (XM430, OpenCR, LB-012, D435, TB3 Waffle Pi / OpenMANIPULATOR-X totals) where available, density estimates otherwise; joint limits are placeholders. -->
<!-- Axis convention: every movable joint uses axis="0 0 1" (joint frame +z = physical axis). -->
<!-- Local edits to the shared xSting_v62.urdf (redo them when a new version arrives, or ask for them upstream):
     1. Wrist camera camera_link / camera_optical_frame (and their joints) renamed gripper_camera_*: the RealSense
        driver run with camera_name:=camera publishes its own camera_link, and a frame must have one parent.
     2. 2nd D435 body lower_camera_link renamed lower_camera_body_link, for the same reason with
        camera_name:=lower_camera. mk1_xsting.urdf.xacro attaches the driver frames to both D435 bodies.
     3. Wheel velocity limit 6.0 -> 8.1 rad/s: XM430-W210 tops out at 77 rpm (8.06 rad/s) at 12 V, and
        ros2_control clamps wheel commands to this, so 6.0 capped the robot at 0.20 m/s instead of 0.27.
     Loaded by mk1_xsting.urdf.xacro, which adds the ros2_control blocks and the driver frames. -->
<robot name="xsting_v62">
  <link name="base_footprint">
  </link>
  <link name="base_link">
    <inertial>
      <origin xyz="0.00327937 -1.10976e-05 0.0820089" rpy="0 0 0"/>
      <mass value="2.32613"/>
      <inertia ixx="4.2720e-02" ixy="1.9937e-04" ixz="8.9513e-05" iyy="3.3332e-02" iyz="3.7979e-06" izz="3.7653e-02"/>
    </inertial>
    <visual>
      <geometry><mesh filename="package://xsting_description/meshes/xsting_v62/visual/base_link_camera.stl"/></geometry>
      <material name="xsting_camera"><color rgba="0.3 0.47 0.78 1"/></material>
    </visual>
    <visual>
      <geometry><mesh filename="package://xsting_description/meshes/xsting_v62/visual/base_link_bracket.stl"/></geometry>
      <material name="xsting_bracket"><color rgba="0.72 0.5 0.85 1"/></material>
    </visual>
    <visual>
      <geometry><mesh filename="package://xsting_description/meshes/xsting_v62/visual/base_link_pillar.stl"/></geometry>
