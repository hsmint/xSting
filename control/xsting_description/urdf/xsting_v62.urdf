    <child link="wheel_rear_left"/>
    <origin xyz="-0.1 0.1439 0.02325" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1.5" velocity="8.1"/>
  </joint>
  <joint name="wheel_rear_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_right"/>
    <origin xyz="-0.1 -0.1439 0.02325" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1.5" velocity="8.1"/>
  </joint>
</robot>
