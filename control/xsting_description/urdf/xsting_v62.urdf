  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.00974998" rpy="0 0 0"/>
  </joint>
  <joint name="pillar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="turret_link"/>
    <origin xyz="0.0023 0.0023 0.527" rpy="0 0 0"/>
  </joint>
  <!-- M1 turntable servo XM430 (top plate) -> disc -->
  <joint name="joint1" type="revolute">
    <parent link="turret_link"/>
    <child link="disc_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="1.5" velocity="4.8"/>
  </joint>
  <!-- M2 arm yaw servo (under the disc) -->
  <joint name="joint2" type="revolute">
    <parent link="disc_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0.055 0 -0.046" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="1.5" velocity="4.8"/>
  </joint>
  <!-- M3 shoulder pitch servo -->
  <joint name="joint3" type="revolute">
    <parent link="shoulder_link"/>
    <child link="arm_link"/>
    <origin xyz="0 0 -0.0387" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0189" upper="1.9431" effort="1.5" velocity="4.8"/>
  </joint>
  <!-- M4 elbow pitch servo -->
  <joint name="joint4" type="revolute">
    <parent link="arm_link"/>
    <child link="elbow_link"/>
    <origin xyz="0.024 0.128 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5478" upper="2.0168" effort="1.5" velocity="4.8"/>
  </joint>
  <!-- M5 wrist pitch servo -->
  <joint name="joint5" type="revolute">
    <parent link="elbow_link"/>
    <child link="wrist_link"/>
    <origin xyz="0.149 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.1032" upper="1.8417" effort="1.5" velocity="4.8"/>
  </joint>
  <!-- M6 wrist roll servo -->
  <joint name="joint6" type="revolute">
    <parent link="wrist_link"/>
    <child link="gripper_link"/>
    <origin xyz="0.0677 0 0" rpy="1.5708 0 1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="1.5" velocity="4.8"/>
  </joint>
  <!-- M7 gripper servo (rack and pinion, finger travel in m) -->
  <joint name="joint7" type="prismatic">
    <parent link="gripper_link"/>
    <child link="finger_l"/>
    <origin xyz="0 -0.0538053 0.0362773" rpy="-1.5708 -1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0000" upper="0.0135" effort="10.0" velocity="0.05"/>
  </joint>
  <joint name="finger_r_joint" type="prismatic">
    <parent link="gripper_link"/>
    <child link="finger_r"/>
    <origin xyz="0 0.0537836 0.0362773" rpy="1.5708 -1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0000" upper="0.0135" effort="10.0" velocity="0.05"/>
    <mimic joint="joint7" multiplier="1" offset="0"/>
  </joint>
  <joint name="gripper_camera_joint" type="fixed">
    <parent link="gripper_link"/>
    <child link="gripper_camera_link"/>
    <origin xyz="-0.0457846 0.000104348 0.0658504" rpy="0 -1.0472 0"/>
  </joint>
  <joint name="gripper_camera_optical_joint" type="fixed">
    <parent link="gripper_camera_link"/>
    <child link="gripper_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>
  <joint name="front_camera_joint" type="fixed">
    <parent link="turret_link"/>
    <child link="front_camera_link"/>
    <origin xyz="0.147257 -0.002243 0.0249983" rpy="0 0.523599 0"/>
  </joint>
  <!-- RealSense D435 body: 75 g (RealSense D400 datasheet rev 023, Table 3-52), split out of turret_link; its
       mounting bracket stays in turret_link. front_camera_link = centre of the D435 body (90 x 25 x 25 mm). Lens centres from the STEP front
       cover, x out of the glass (glass at x +12.5 mm), y to the camera's left: RGB +32.4 mm, left IR +17.4 mm
       (RealSense driver depth origin, camera_link of realsense2_description), projector -11.6 mm,
       right IR -32.6 mm. depth_cam_link sits on the IR projector, RGB_cam_link on the RGB lens. -->
  <joint name="depth_cam_joint" type="fixed">
    <parent link="front_camera_link"/>
    <child link="depth_cam_link"/>
    <origin xyz="0.00785 -0.011557 0" rpy="0 0 0"/>
  </joint>
  <joint name="RGB_cam_joint" type="fixed">
    <parent link="front_camera_link"/>
    <child link="RGB_cam_link"/>
    <origin xyz="0.00785 0.032443 0" rpy="0 0 0"/>
  </joint>
  <!-- 2nd RealSense D435 (STEP Intel_RealSense_Depth_Camera_D435:2), 3rd deck front on D435_FRONT_BRACKET,
       looking straight ahead (x forward, level). Same camera and layout as front_camera_link: body centre,
       75 g body split out of base_link (its bracket stays in base_link); lower_depth_cam_link on the IR
       projector, lower_RGB_cam_link on the RGB lens. RealSense driver: camera_name:=lower_camera. -->
  <joint name="lower_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lower_camera_body_link"/>
    <origin xyz="0.124925 5.7e-05 0.108" rpy="0 0 0"/>
  </joint>
  <joint name="lower_depth_cam_joint" type="fixed">
    <parent link="lower_camera_body_link"/>
    <child link="lower_depth_cam_link"/>
    <origin xyz="0.00785 -0.011557 0" rpy="0 0 0"/>
  </joint>
  <joint name="lower_RGB_cam_joint" type="fixed">
    <parent link="lower_camera_body_link"/>
    <child link="lower_RGB_cam_link"/>
    <origin xyz="0.00785 0.032443 0" rpy="0 0 0"/>
  </joint>
  <!-- The two OpenCR 1.0 boards (105 x 75 mm) of the STEP, origin = PCB centre (MANIFOLD_SOLID_BREP_33156),
       axes = parent axes (both boards lie flat, edges along x / y, same heading).
       2nd deck: FL2 > OPENCR_NEW_ASM <1>:1, front centre (PCB centre x 64 mm), directly on the FL2 plate (top z 46.5 mm), PCB z 49.79~51.51 mm.
       4th deck: FL2 > OPENCR_NEW_ASM <1>:2, on the top plate (top z 448.8 mm), PCB z 458.82~460.54 mm.
       Each board: 60 g (ROBOTIS OpenCR 1.0 e-manual), split out of base_link / turret_link. -->
  <joint name="opencr_joint" type="fixed">
    <parent link="base_link"/>
    <child link="opencr_link"/>
    <origin xyz="0.064 0 0.05065" rpy="0 0 0"/>
  </joint>
  <joint name="opencr_top_joint" type="fixed">
    <parent link="turret_link"/>
    <child link="opencr_top_link"/>
    <origin xyz="-0.0342 0.1222 0.032679" rpy="0 0 0"/>
  </joint>
  <!-- IMU (MPU9250, 3x3x1 mm, MANIFOLD_SOLID_BREP_33179) at the PCB centre of the 2nd deck OpenCR: chip centre is
       1.325 mm above the PCB centre. Axes = base_link, as turtlebot3_description's imu_joint. -->
  <joint name="imu_joint" type="fixed">
    <parent link="opencr_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.001325" rpy="0 0 0"/>
  </joint>
  <!-- Components split out of base_link / turret_link with datasheet masses (frame-only children: their
       meshes stay in the parent). Origin = component bbox centre, axes = parent axes. -->
  <!-- LB-012 LiPo 11.1 V 1800 mAh, 1st deck front centre (STEP LIPO_LB-012_11.1V_1800mAh:1), 106 g (ROBOTIS) -->
  <joint name="battery_joint" type="fixed">
    <parent link="base_link"/>
    <child link="battery_link"/>
    <origin xyz="0.064 0 0.022" rpy="0 0 0"/>
  </joint>
  <!-- LB-012 LiPo 11.1 V 1800 mAh, top plate (STEP LIPO_LB-012_11.1V_1800mAh:2), 106 g (ROBOTIS) -->
  <joint name="battery_top_joint" type="fixed">
    <parent link="turret_link"/>
    <child link="battery_top_link"/>
    <origin xyz="0.0682 0.1397 0.0348326" rpy="0 0 0"/>
  </joint>
  <!-- Jetson Orin Nano Developer Kit, top plate (STEP P3766-P3768SKU4-P3767ENVELOPE:1), 175 g (NVIDIA SP-11324-001) -->
  <joint name="jetson_joint" type="fixed">
    <parent link="turret_link"/>
    <child link="jetson_link"/>
    <origin xyz="-0.0013 -0.125738 0.0392156" rpy="0 0 0"/>
  </joint>
  <joint name="wheel_front_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_left"/>
    <origin xyz="0.1 0.1439 0.02325" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1.5" velocity="8.1"/>
  </joint>
  <joint name="wheel_front_right_joint" type="continuous">
