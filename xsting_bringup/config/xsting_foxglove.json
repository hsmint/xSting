  "userNodes": {
    "d3d00001-5873-4f62-9a11-000000000001": {
      "name": "detections_3d_scene",
      "sourceCode": "import { Input } from \"./types.ts\";\nimport {\n  SceneUpdate,\n  SceneEntity,\n  SceneEntityDeletionType,\n  Color,\n} from \"@foxglove/schemas\";\n\nexport const inputs = [\"/detections_3d\"];\nexport const output = \"/detections_3d/scene\";\n\nfunction classColor(cls: string, alpha: number): Color {\n  if (cls.startsWith(\"red_\")) {\n    return { r: 1.0, g: 0.2, b: 0.2, a: alpha };\n  }\n  if (cls.startsWith(\"green_\")) {\n    return { r: 0.15, g: 0.95, b: 0.3, a: alpha };\n  }\n  if (cls === \"paper_box\") {\n    return { r: 0.95, g: 0.65, b: 0.2, a: alpha };\n  }\n  return { r: 0.2, g: 0.8, b: 1.0, a: alpha };\n}\n\nexport default function script(\n  event: Input<\"/detections_3d\">,\n): SceneUpdate {\n  const msg = event.message;\n  const stamp = event.receiveTime;\n  const frameId = msg.header.frame_id || \"base\";\n  const entities: SceneEntity[] = [];\n  const halfSqrt2 = Math.SQRT1_2;\n\n  for (let i = 0; i < msg.detections.length; i++) {\n    const det = msg.detections[i];\n    if (!det) {\n      continue;\n    }\n    const hyp = det.results[0]?.hypothesis;\n    const cls = hyp?.class_id ?? \"obj\";\n    const score = hyp?.score ?? 0;\n    const pos = det.bbox.center.position;\n    const ori = det.bbox.center.orientation;\n    const sz = det.bbox.size;\n    const isCyl = cls.includes(\"cylinder\");\n    const boxColor = classColor(cls, 0.55);\n    const solidColor = classColor(cls, 1.0);\n    const pose = {\n      position: { x: pos.x, y: pos.y, z: pos.z },\n      orientation: { x: ori.x, y: ori.y, z: ori.z, w: ori.w },\n    };\n    const size = {\n      x: Math.max(0.01, sz.x),\n      y: Math.max(0.01, sz.y),\n      z: Math.max(0.01, sz.z),\n    };\n    const cylPose = {\n      position: { x: pos.x, y: pos.y, z: pos.z },\n      orientation: {\n        x: halfSqrt2 * (ori.x - ori.z),\n        y: halfSqrt2 * (ori.w + ori.y),\n        z: halfSqrt2 * (ori.x + ori.z),\n        w: halfSqrt2 * (ori.w - ori.y),\n      },\n    };\n    const cylSize = {\n      x: size.z,\n      y: size.y,\n      z: size.x,\n    };\n    const maxHalf = Math.max(size.x, size.y, size.z) * 0.5;\n    const label = `${cls} ${(score * 100).toFixed(0)}% (${pos.x.toFixed(2)}, ${pos.y.toFixed(2)}, ${pos.z.toFixed(2)})`;\n\n    entities.push({\n      timestamp: stamp,\n      frame_id: frameId,\n      id: `det_${i}`,\n      lifetime: { sec: 0, nsec: 300000000 },\n      frame_locked: true,\n      metadata: [],\n      arrows: [\n        {\n          pose,\n          shaft_length: Math.max(0.04, size.x * 0.6),\n          shaft_diameter: 0.008,\n          head_length: 0.025,\n          head_diameter: 0.018,\n          color: { r: 1.0, g: 0.95, b: 0.1, a: 1.0 },\n        },\n      ],\n      cubes: isCyl ? [] : [{ pose, size, color: boxColor }],\n      spheres: [],\n      cylinders: isCyl\n        ? [{ pose: cylPose, size: cylSize, bottom_scale: 1.0, top_scale: 1.0, color: boxColor }]\n        : [],\n      lines: [],\n      triangles: [],\n      texts: [\n        {\n          pose: {\n            position: {\n              x: pos.x,\n              y: pos.y,\n              z: pos.z + Math.max(0.04, maxHalf + 0.04),\n            },\n            orientation: { x: 0, y: 0, z: 0, w: 1 },\n          },\n          billboard: true,\n          font_size: 13,\n          scale_invariant: true,\n          color: solidColor,\n          text: label,\n        },\n      ],\n      models: [],\n    });\n  }\n\n  const update: SceneUpdate = {\n    deletions: [\n      {\n        timestamp: stamp,\n        type: SceneEntityDeletionType.ALL,\n        id: \"\",\n      },\n    ],\n    entities,\n  };\n  return update;\n}\n"
    }
  },
