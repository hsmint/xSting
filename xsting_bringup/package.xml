<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xsting_bringup</name>
  <version>0.0.0</version>
  <description>Unified bringup package for xSting vision, cuVSLAM, nvblox, YOLOv8, URDF, Foxglove, and RViz2</description>
  <maintainer email="hwa04866@gmail.com">SangHwaKim09</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xsting_vision</exec_depend>
  <exec_depend>xsting_description</exec_depend>
  <exec_depend>coin_d4_driver</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>isaac_ros_cuvslam</exec_depend>
  <exec_depend>nvblox_ros</exec_depend>
  <exec_depend>isaac_ros_dnn_image_encoder</exec_depend>
  <exec_depend>isaac_ros_tensor_rt</exec_depend>
  <exec_depend>isaac_ros_yolov8</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xsting_hardware</exec_depend>
  <exec_depend>xsting_nav</exec_depend>
  <exec_depend>xsting_approach</exec_depend>
  <exec_depend>xsting_pick_place</exec_depend>
  <exec_depend>xsting_mission</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
