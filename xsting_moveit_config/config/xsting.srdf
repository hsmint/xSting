<robot name="xsting">
  <group name="arm">
    <chain base_link="base" tip_link="tool0" />
  </group>
  <group name="gripper">
    <joint name="finger_l" />
    <joint name="finger_r" />
  </group>
  <end_effector name="hand" parent_link="gripper" group="gripper" parent_group="arm" />
