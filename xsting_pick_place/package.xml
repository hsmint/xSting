<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xsting_pick_place</name>
  <version>0.1.0</version>
  <description>MoveIt and Isaac ROS cuMotion pick-and-place for xSting</description>
  <maintainer email="pa03@todo.todo">pa03</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>control_msgs</depend>
  <depend>cuda_buffer</depend>
  <depend>geometry_msgs</depend>
  <depend>libopencv-dev</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>sensor_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>xsting_interfaces</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xsting_description</exec_depend>
  <exec_depend>xsting_moveit_config</exec_depend>
  <exec_depend>xsting_vision</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
