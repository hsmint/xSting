<?xml version="1.0"?>
<package format="3">
  <name>xsting_hardware</name>
  <version>0.1.0</version>
  <description>xSting 다리, 팔 OpenCR용 ros2_control 하드웨어</description>
  <maintainer email="spalstlr321@naver.com">minsikim-42</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>dynamixel_sdk</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>imu_sensor_broadcaster</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>range_sensor_broadcaster</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xsting_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
