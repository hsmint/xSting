#usda 1.0
(
    defaultPrim = "xsting"
    endTimeCode = 1000000000
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "xsting" (
    customData = {
        dictionary storage = {
            double3 nominalPuckSize = (0.03, 0.03, 0.06)
        }
    }
    prepend references = @./xsting_training.usda@
)
{
    over "base"
    {
        over "base_link_1" (
            active = false
        )
        {
        }

        def Xform "StorageColliders" (
            instanceable = true
            prepend references = @./storage/storage_colliders.usdc@
