  <!-- HC-SR04 ultrasonic range sensor on ultrasonic (+X = beam, origin = transducer front faces).
       Datasheet: 0.02-4.0 m, 15 deg measuring angle, 3 mm resolution, 40 kHz, >= 60 ms period.
       ROS: sensor_msgs/Range with header.frame_id "ultrasonic", ULTRASOUND (0), fov 0.261799 rad, min 0.02, max 4.0. -->
  <sensor name="ultrasonic_front" update_rate="15">
    <parent link="ultrasonic" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <ray>
      <horizontal samples="5" resolution="1" min_angle="-0.1309" max_angle="0.1309" />
      <vertical samples="5" resolution="1" min_angle="-0.1309" max_angle="0.1309" />
    </ray>
  </sensor>
  <!-- ROBOTIS LDS-03 (COIN-D4) 360 deg 2D ToF LiDAR at lowest waffle-deck center (+X = 0 rad, CCW).
       ROS: sensor_msgs/LaserScan with header.frame_id "lidar", min 0.10 m, max 12.0 m, 10 Hz. -->
  <sensor name="lidar_2d" update_rate="10">
    <parent link="lidar" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <ray>
      <horizontal samples="720" resolution="1" min_angle="0" max_angle="6.2831853" />
      <vertical samples="1" resolution="1" min_angle="0" max_angle="0" />
    </ray>
  </sensor>
</robot>
